{
  "_comment": "Example: LDPlayer running Blue Archive (JP). The worker probes via `adb -s 127.0.0.1:5555 shell pidof com.YostarJP.BlueArchive` before any task probe runs.",
  "version": 1,
  "mode": "local",
  "ssh_host": null,
  "remote_platform": null,
  "remote_workdir": null,
  "sync_strategy": null,
  "remote_python": null,
  "target": {
    "kind": "device",
    "emulator": {
      "name": "ldplayer-9",
      "exec_path": "C:/LDPlayer/LDPlayer9/dnplayer.exe",
      "args": ["--instance", "0"],
      "adb_port": 5555
    },
    "device": {
      "id": "127.0.0.1:5555",
      "kind": "adb",
      "transport": "tcp"
    },
    "game_window": {
      "title_pattern": "BlueArchive",
      "class_pattern": null,
      "pid_lookup_strategy": "adb-focused-app"
    },
    "probe_command": "adb -s 127.0.0.1:5555 shell pidof com.YostarJP.BlueArchive"
  }
}
